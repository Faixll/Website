# Stripe (https://dashboard.stripe.com/test/apikeys). Use TEST keys until launch.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Optional: every new order / notify-me / contact message is POSTed here as JSON
# (e.g. a Make/Zapier hook that forwards to WhatsApp or email). Leave empty to only log.
ORDER_WEBHOOK_URL=

# Public site URL (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://example.ae


# ---------------------------------------------------------------- Part B (all optional; default OFF)
# Postgres (Neon or Supabase Postgres). With it, every order is saved and visible at /admin/orders.
# After setting it, create the tables once: npm run db:migrate
DATABASE_URL=

# 32+ random characters. Signs the customer and admin cookies. REQUIRED in production for sign-in and /admin.
SESSION_SECRET=

# Password for /admin (orders, points, reviews). Rate-limited: 5 wrong tries per 15 minutes per IP.
ADMIN_PASSWORD=

# Rewards + reviews writing. Stays hidden unless this is true AND DATABASE_URL, SESSION_SECRET and a code sender are set.
REWARDS_ENABLED=false

# Points rules — EXAMPLE values, the client must decide. Read at build time.
NEXT_PUBLIC_POINTS_PER_AED=1
NEXT_PUBLIC_AED_PER_100_POINTS=5

# Sign-in codes by SMS / WhatsApp (production). In development the code is printed in the server log.
OTP_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# SMS sender (+1...) or an approved WhatsApp sender (whatsapp:+971...)
TWILIO_FROM=
