# Stripe (https://dashboard.stripe.com/test/apikeys). Use TEST keys until launch.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Optional: every new order / notify-me / contact message is POSTed here as JSON
# (e.g. a Make/Zapier hook that forwards to WhatsApp or email). Leave empty to only log.
ORDER_WEBHOOK_URL=

# Public site URL (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://example.ae

# Supabase (accounts + points). Project settings → API. Leave empty to run guest-only.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SERVER ONLY — never expose. Used to create orders and move points.
SUPABASE_SERVICE_ROLE_KEY=
